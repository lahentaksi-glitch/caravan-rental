# Canonical site URL (sitemap, robots, Open Graph, JSON-LD)
# Production example: https://lahdenvaunujapalju.fi
NEXT_PUBLIC_SITE_URL=https://caravanrentlahti.fi

# Optional Google Analytics 4 measurement ID (format G-XXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Optional Plausible Analytics site domain (e.g. lahdenvaunujapalju.fi)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Optional Google Maps iframe src override for the pickup point
# Leave empty to use the built-in Lahti embed.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Resend (https://resend.com) — booking confirmation emails
# Without RESEND_API_KEY the API stays in mock mode: WhatsApp still works,
# and the email button falls back to mailto:.
RESEND_API_KEY=
# Verified sender, e.g. Caravan Rent Lahti <varaus@lahdenvaunujapalju.fi>
RESEND_FROM=
# Owner inbox for new booking alerts (defaults to site.email)
BOOKING_NOTIFY_EMAIL=
